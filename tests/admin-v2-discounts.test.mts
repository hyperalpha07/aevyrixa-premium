import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import test from "node:test";
const read=(p:string)=>readFileSync(new URL(`../${p}`,import.meta.url),"utf8");
test("coupon validation enforces code, amount, dates and limits",()=>{const source=read("lib/admin-v2/discounts-store.ts");assert.match(source,/codePattern/);assert.match(source,/discountValue>100/);assert.match(source,/usageLimit<1/);assert.match(source,/expiresAt<=startsAt/);});
test("coupon checkout is transactional and least privilege",()=>{const sql=read("supabase/migrations/20261120090000_admin_v2_discounts_atomic_checkout.sql");const api=read("app/api/admin-v2/discounts/route.ts");const checkout=read("app/lib/order-store.ts");assert.match(sql,/for update/);assert.match(sql,/insert into public\.orders/);assert.match(sql,/insert into public\.discount_redemptions/);assert.match(sql,/usage_count=usage_count\+1/);assert.match(sql,/revoke all.*anon.*authenticated/is);assert.match(api,/"discounts\.manage"/);assert.match(checkout,/checkout_create_order_with_coupon/);});
test("coupon RPC rejects unsafe state and is retry-safe by order reference",()=>{const sql=read("supabase/migrations/20261120090000_admin_v2_discounts_atomic_checkout.sql");assert.match(sql,/not v_coupon\.is_active/);assert.match(sql,/v_coupon\.expires_at <= now\(\)/);assert.match(sql,/v_coupon\.usage_count >= v_coupon\.usage_limit/);assert.match(sql,/if found then[\s\S]*v_existing\.coupon_code = v_code/);assert.match(sql,/unique \(order_ref\)/);assert.match(sql,/v_total := round\(v_subtotal-v_discount\+v_delivery,2\)/);});
test("admin CRUD and checkout input remain server-authoritative",()=>{const patch=read("app/api/admin-v2/discounts/[id]/route.ts");const client=read("components/admin-v2/views/discounts/AdminV2DiscountCouponManager.tsx");const checkout=read("app/checkout/page.tsx");const orderRoute=read("app/api/orders/route.ts");assert.match(patch,/verifyFreshAdminRequestPermission\(request,"discounts\.manage"\)/);assert.match(client,/Used \{coupon\.usageCount\}/);assert.match(checkout,/Discount code optional/);assert.match(orderRoute,/createOrderWithCoupon/);assert.doesNotMatch(orderRoute,/discountAmount.*payload/);});

test("coupon attribution reaches returned orders and issued invoice snapshots",()=>{const record=read("app/lib/order-types.ts");const store=read("app/lib/order-store.ts");const invoice=read("lib/admin-v2/orders/order-invoices.ts");assert.match(record,/couponCode\?: string/);assert.match(store,/"coupon_code"/);assert.match(store,/couponCode: row\.coupon_code/);assert.match(invoice,/code: order\.couponCode/);});

test("coupon order path preserves financial snapshots and protects redeemed attribution",()=>{const sql=read("supabase/migrations/20261120090000_admin_v2_discounts_atomic_checkout.sql");assert.match(sql,/paid_amount,due_amount,refunded_amount,payment_verified_at/);assert.match(sql,/= 'Cash on Delivery' then v_total/);assert.match(sql,/usage_limit is null or usage_count <= usage_limit/);assert.match(sql,/A redeemed discount code cannot be changed/);});
